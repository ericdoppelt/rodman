ANTHROPIC_API_KEY=
MASSIVE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TAVILY_API_KEY=
# Alpaca paper trading keys (free, no card required — dashboard.alpaca.markets, "Paper" account).
# See docs/decisions/0012-alpaca-paper-trading-execution.md.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# pnpm backtest only. BULL_BEAR_MODEL is optional (leave unset to match production's cheap Haiku
# model). JUDGE_MODEL is REQUIRED — pnpm backtest errors if unset, since production's judge is
# claude-opus-5, which is expensive at backtest volume and has memorized knowledge of 2025 stock
# outcomes that contaminates backtest validity. Set explicitly: claude-sonnet-5 for cheap
# iteration, or claude-opus-5 for a deliberate fidelity-matched run (see BACKLOG.md).
BACKTEST_BULL_BEAR_MODEL=
BACKTEST_JUDGE_MODEL=
# Optional, pnpm backtest only — how many days' worth of Claude research run concurrently.
# Defaults to 4. Raise once you know your Anthropic tier's real rate-limit headroom.
BACKTEST_CONCURRENCY=
