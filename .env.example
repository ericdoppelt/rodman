ANTHROPIC_API_KEY=
MASSIVE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TAVILY_API_KEY=
# Optional, pnpm backtest only — cheap models for iterating on the harness itself. Leave unset
# for any run whose results you actually intend to trust (see BACKLOG.md).
BACKTEST_BULL_BEAR_MODEL=
BACKTEST_JUDGE_MODEL=
# Optional, pnpm backtest only — how many days' worth of Claude research run concurrently.
# Defaults to 4. Raise once you know your Anthropic tier's real rate-limit headroom.
BACKTEST_CONCURRENCY=
